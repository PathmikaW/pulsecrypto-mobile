{
  "expo": {
    "name": "pulsecrypto-mobile",
    "slug": "pulsecrypto-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.pulsecryptomobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.pulsecryptomobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-localization", "expo-font", "expo-splash-screen", "expo-image"],
    "extra": {
      "eas": {
        "projectId": "3240ab86-1428-4eff-a3c7-0e4f7ccc65a0"
      }
    }
  }
}
