# The only two settings the app needs: where the backend is. They are public URLs, not secrets, and they
# are inlined into the app bundle at build time (EXPO_PUBLIC_ prefix) — never put a secret in this file.
# After changing them, restart Metro with `pnpm expo start --dev-client --clear`.
#
# Android Emulator + backend running on this machine (10.0.2.2 is the emulator's alias for the host):
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
EXPO_PUBLIC_WS_BASE_URL=ws://10.0.2.2:3000
#
# Physical device + backend on this machine, same Wi-Fi: use the machine's LAN address instead
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000
#   EXPO_PUBLIC_WS_BASE_URL=ws://192.168.x.x:3000
#
# The owner's hosted backend (over TLS; only while the instance is running):
#   EXPO_PUBLIC_API_BASE_URL=https://pulsecrypto.duckdns.org
#   EXPO_PUBLIC_WS_BASE_URL=wss://pulsecrypto.duckdns.org
#
# Release builds refuse anything that is not https:// and wss:// (ADR-M6); plain http/ws is for development builds.
